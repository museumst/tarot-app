rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      // 본인만 읽을 수 있다.
      allow read: if isOwner(uid);

      // 문서 최초 생성만 허용하고, 0 으로 시작해야 한다.
      // 이후 free_used·credits 는 서버(서비스 계정, credits.py)만 바꾼다 → 브라우저에서 크레딧을 늘릴 수 없다.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['email', 'free_used', 'credits', 'created_at'])
        && request.resource.data.free_used == 0
        && request.resource.data.credits == 0;
      allow update, delete: if false;

      // 크레딧 이용내역: 읽기만. 기록은 서버(결제 지급·리딩 차감·환불 회수)가 쓴다.
      match /creditHistory/{docId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // 저장한 리딩: 본인이 읽고 쓴다.
      match /readings/{readingId} {
        allow read, write: if isOwner(uid);
      }
    }

    // payments, refundLedger, refundIssues 등 그 밖의 컬렉션은 규칙이 없으므로 클라이언트가 접근할 수 없다(서버 전용).
  }
}
